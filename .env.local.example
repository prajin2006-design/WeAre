# ==============================================================================
# WeAre Streaming Platform - Environment Configuration (.env.local)
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# 1. Supabase Project Configuration (https://supabase.com)
# Create a free project on Supabase and obtain your project URL and keys from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Service Role Key (SERVER-SIDE ONLY)
# Used exclusively on the server for automated catalog imports, migrations, and administrative maintenance.
# NEVER expose this key in client-side code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. TMDB API Access Token (SERVER-SIDE ONLY)
# Obtain your free API Read Access Token (v4 auth Bearer token) from https://www.themoviedb.org/settings/api
# NEVER expose this token in client-side code or prefix with NEXT_PUBLIC_.
TMDB_API_TOKEN=your-tmdb-v4-read-access-token-here

# 4. NexStream API Key (SERVER-SIDE ONLY)
# Official high-performance streaming integration for authorized catalog titles.
# NEVER expose this key in client-side code or prefix with NEXT_PUBLIC_.
NEXSTREAM_API_KEY=your-nexstream-api-key-here

# 5. Application URL (used for Auth callback redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000


